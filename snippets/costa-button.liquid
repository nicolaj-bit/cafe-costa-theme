{% comment %} Én knap fra en button-block: render 'costa-button', block: block {% endcomment %}
{%- if block.settings.label != blank -%}
  <a
    href="{{ block.settings.link | default: '#' }}"
    class="costa-button{% if block.settings.style == 'secondary' %} costa-button--secondary{% endif %}"
    {{ block.shopify_attributes }}
  >
    {{- block.settings.label | escape -}}
  </a>
{%- endif -%}
