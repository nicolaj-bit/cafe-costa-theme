{%- liquid
  assign color_class = ''
  if section.settings.color == 'surface'
    assign color_class = ' costa--surface'
  elsif section.settings.color == 'dark'
    assign color_class = ' costa--dark'
  endif
-%}

<section class="costa{{ color_class }}">
  <div class="costa__inner">
    {%- if section.settings.heading != blank -%}<h2 class="costa--center">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="costa-cards">
      {%- for block in section.blocks -%}
        <article class="costa-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <a class="costa-card__media" href="{{ block.settings.link | default: '#' }}" tabindex="-1" aria-hidden="true">
              {%- render 'costa-image', image: block.settings.image, sizes: '(min-width: 750px) 33vw, 100vw' -%}
            </a>
          {%- endif -%}
          <div class="costa-card__body">
            <h3>{{ block.settings.title }}</h3>
            {{ block.settings.text }}
            {%- if block.settings.button_label != blank -%}
              <div class="costa-buttons">
                <a class="costa-button costa-button--secondary" href="{{ block.settings.link | default: '#' }}">{{ block.settings.button_label | escape }}<span class="visually-hidden">: {{ block.settings.title | strip_html }}</span></a>
              </div>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Costa: fokuskort",
  "tag": "div",
  "class": "costa-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Overskrift (valgfri)"
    },
    {
      "type": "select",
      "id": "color",
      "label": "Baggrund",
      "default": "bg",
      "options": [
        {
          "value": "bg",
          "label": "Lys"
        },
        {
          "value": "surface",
          "label": "Flade"
        },
        {
          "value": "dark",
          "label": "Mørk"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "card",
      "name": "Kort",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Billede"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Titel",
          "default": "Titel"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Tekst",
          "default": "<p>Kort beskrivelse.</p>"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Knaptekst",
          "default": "Læs mere"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Costa: fokuskort",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}
