{%- liquid
  assign color_class = ''
  if section.settings.color == 'surface'
    assign color_class = ' costa--surface'
  elsif section.settings.color == 'dark'
    assign color_class = ' costa--dark'
  elsif section.settings.color == 'harbor'
    assign color_class = ' costa--harbor'
  endif
-%}

{%- comment -%}
  Menukort: hver kategori samles i sit eget kort med nummer, titel og note.
  Retterne står i to spalter på computer med en prikket linje hen til prisen.
  Blokkene samles med capture, så HTML'en altid er lukket korrekt.
{%- endcomment -%}
{%- assign categories = section.blocks | where: 'type', 'category' -%}
{%- assign has_cat = false -%}
{%- assign cat_head = '' -%}
{%- assign cat_body = '' -%}
{%- assign cat_class = '' -%}
{%- assign cat_id = '' -%}
<section class="costa costa-menu-card{{ color_class }}">
  <div class="costa__inner">
    {%- if section.settings.show_nav and categories.size > 1 -%}
      <nav class="costa-menu__jump" aria-label="{{ 'costa.menu.nav_label' | t }}">
        {%- for block in categories -%}
          {%- if block.settings.nav_label != blank -%}
            <a href="#{{ block.settings.anchor | default: block.settings.title | handleize }}">{{ block.settings.nav_label }}</a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'category' -%}
        {%- if has_cat -%}
          <section class="costa-menu__cat{{ cat_class }}" id="{{ cat_id }}">{{ cat_head }}<div class="costa-menu__items">{{ cat_body }}</div></section>
        {%- endif -%}
        {%- assign has_cat = true -%}
        {%- assign cat_id = block.settings.anchor | default: block.settings.title | handleize -%}
        {%- assign cat_class = '' -%}
        {%- if block.settings.style != 'plain' and block.settings.style != blank -%}{%- assign cat_class = ' costa-menu__cat--' | append: block.settings.style -%}{%- endif -%}
        {%- capture cat_head -%}
          <header class="costa-menu__cathead" {{ block.shopify_attributes }}>
            {%- if block.settings.number != blank -%}<span class="costa-label costa-menu__num">{{ block.settings.number | escape }}</span>{%- endif -%}
            <h2 class="costa-menu__category">{{ block.settings.title }}</h2>
            {%- if block.settings.note != blank -%}<p class="costa-menu__note">{{ block.settings.note }}</p>{%- endif -%}
          </header>
        {%- endcapture -%}
        {%- assign cat_body = '' -%}
        {%- continue -%}
      {%- endif -%}

      {%- capture piece -%}
        {%- case block.type -%}
          {%- when 'jumpnav' -%}
            <nav class="costa-menu__jump costa-menu__span" aria-label="{{ 'costa.menu.nav_label' | t }}" {{ block.shopify_attributes }}>{{ block.settings.links }}</nav>
          {%- when 'group' -%}
            <div class="costa-menu__group costa-menu__span" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.title }}</h3>
              {%- if block.settings.note != blank -%}<p class="costa-menu__note">{{ block.settings.note }}</p>{%- endif -%}
            </div>
          {%- when 'item' -%}
            <div class="costa-menu__item" {{ block.shopify_attributes }}>
              <div class="costa-menu__line">
                <span class="costa-menu__name">{{ block.settings.name }}</span>
                <span class="costa-menu__leader" aria-hidden="true"></span>
                <span class="costa-menu__price">{{ block.settings.price | newline_to_br }}</span>
              </div>
              {%- if block.settings.description != blank -%}<div class="costa-menu__desc">{{ block.settings.description }}</div>{%- endif -%}
            </div>
          {%- when 'text' -%}
            <div class="costa-richtext costa-menu__text costa-menu__span" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'image' -%}
            <div class="costa-menu__images costa-menu__span" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}<figure>{%- render 'costa-image', image: block.settings.image, sizes: '(min-width: 990px) 560px, 90vw' -%}</figure>{%- endif -%}
              {%- if block.settings.image_2 != blank -%}<figure>{%- render 'costa-image', image: block.settings.image_2, sizes: '(min-width: 990px) 560px, 90vw' -%}</figure>{%- endif -%}
            </div>
        {%- endcase -%}
      {%- endcapture -%}
      {%- if has_cat -%}
        {%- assign cat_body = cat_body | append: piece -%}
      {%- else -%}
        {{ piece }}
      {%- endif -%}
    {%- endfor -%}
    {%- if has_cat -%}
      <section class="costa-menu__cat{{ cat_class }}" id="{{ cat_id }}">{{ cat_head }}<div class="costa-menu__items">{{ cat_body }}</div></section>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}<div class="costa-menu__foot costa-muted">{{ section.settings.footnote }}</div>{%- endif -%}
    {%- if section.settings.show_top_link -%}<p class="costa-menu__top"><a href="#MainContent">{{ 'costa.menu.to_top' | t }} ↑</a></p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Costa: menukort",
  "tag": "div",
  "class": "costa-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_nav",
      "label": "Vis genveje til kategorierne øverst",
      "default": true
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Note nederst"
    },
    {
      "type": "checkbox",
      "id": "show_top_link",
      "label": "Vis «Til top»-link",
      "default": true
    },
    {
      "type": "select",
      "id": "color",
      "label": "Baggrund",
      "default": "bg",
      "options": [
        {
          "value": "bg",
          "label": "Papir"
        },
        {
          "value": "surface",
          "label": "Kort (lysere papir)"
        },
        {
          "value": "dark",
          "label": "Mørk"
        },
        {
          "value": "harbor",
          "label": "Havneblå"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "blocks": [
    {
      "type": "category",
      "name": "Kategori",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Nummer (lille mono-tekst)",
          "info": "F.eks. 01."
        },
        {
          "type": "select",
          "id": "style",
          "label": "Udseende",
          "default": "plain",
          "options": [
            {
              "value": "plain",
              "label": "Almindelig"
            },
            {
              "value": "kraft",
              "label": "Fremhævet på kraftpapir"
            },
            {
              "value": "dark",
              "label": "Fremhævet på mørk bund"
            }
          ]
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Overskrift",
          "default": "Kategori"
        },
        {
          "type": "text",
          "id": "nav_label",
          "label": "Navn i genvejene",
          "info": "Tomt = vises ikke i genvejene."
        },
        {
          "type": "text",
          "id": "anchor",
          "label": "Anker-id",
          "info": "F.eks. morgenmad – så virker links som /pages/menu#morgenmad."
        },
        {
          "type": "inline_richtext",
          "id": "note",
          "label": "Note under overskriften"
        }
      ]
    },
    {
      "type": "jumpnav",
      "name": "Genveje",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "links",
          "label": "Links",
          "info": "Links til ankre, f.eks. #morgenmad. Vises som piller.",
          "default": "<p>Morgenmad · Frokost</p>"
        }
      ]
    },
    {
      "type": "group",
      "name": "Undergruppe",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Overskrift",
          "default": "Undergruppe"
        },
        {
          "type": "inline_richtext",
          "id": "note",
          "label": "Note"
        }
      ]
    },
    {
      "type": "item",
      "name": "Ret",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "name",
          "label": "Navn",
          "default": "Ret"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Beskrivelse"
        },
        {
          "type": "textarea",
          "id": "price",
          "label": "Pris",
          "info": "Én pris pr. linje, hvis der er flere.",
          "default": "0,-"
        }
      ]
    },
    {
      "type": "text",
      "name": "Tekst",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Tekst",
          "default": "<p>Skriv din tekst her.</p>"
        }
      ]
    },
    {
      "type": "image",
      "name": "Billeder",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Billede 1"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Billede 2"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Costa: menukort",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
