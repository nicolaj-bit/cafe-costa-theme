{%- liquid
  assign logo = section.settings.logo
-%}
<section
  class="costa-hero costa-hero--{{ section.settings.height }}"
  style="--costa-logo-width: {{ section.settings.logo_width }}px;"
  {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}"{% endif %}
>
  {%- if section.settings.image != blank -%}
    <div class="costa-hero__media">
      {%- render 'costa-image', image: section.settings.image, loading: 'eager', sizes: '100vw' -%}
    </div>
  {%- endif -%}
  <div class="costa-hero__content costa">
    {%- if section.settings.show_logo -%}
      <div class="costa-hero__logo">
        {%- if logo != blank -%}
          {{ logo | image_url: width: 600 | image_tag: alt: shop.name, loading: 'eager' }}
        {%- else -%}
          <img src="{{ 'costa-logo-grafik.svg' | asset_url }}" alt="{{ settings.costa_cafe_name | escape }}" width="1059" height="661">
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- assign buttons = '' -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'button' -%}
        {%- capture one_button -%}{%- render 'costa-button', block: block -%}{%- endcapture -%}
        {%- assign buttons = buttons | append: one_button -%}
        {%- continue -%}
      {%- endif -%}
      {%- if buttons != blank -%}<div class="costa-buttons">{{ buttons }}</div>{%- assign buttons = '' -%}{%- endif -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          {%- assign tag = block.settings.tag | default: 'h1' -%}
          <{{ tag }} class="costa-hero__title costa-h" {{ block.shopify_attributes }}>{{ block.settings.heading }}</{{ tag }}>
        {%- when 'tagline' -%}
          <p class="costa-hero__tagline" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
        {%- when 'text' -%}
          <div {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
      {%- endcase -%}
    {%- endfor -%}
    {%- if buttons != blank -%}<div class="costa-buttons">{{ buttons }}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Costa: hero",
  "tag": "div",
  "class": "costa-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Baggrundsbillede"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Højde",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "Lav (undersider)"
        },
        {
          "value": "medium",
          "label": "Mellem"
        },
        {
          "value": "large",
          "label": "Høj (forside)"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Vis logo",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (tomt = caféens standardlogo)"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logobredde",
      "min": 60,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anker-id (til links som #morgenmad)",
      "info": "Kun små bogstaver og bindestreger."
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Overskrift",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Overskrift",
          "default": "Overskrift"
        },
        {
          "type": "select",
          "id": "tag",
          "label": "Niveau",
          "default": "h1",
          "options": [
            {
              "value": "h1",
              "label": "H1 – sidens hovedoverskrift"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            },
            {
              "value": "p",
              "label": "Almindelig tekst"
            }
          ]
        }
      ]
    },
    {
      "type": "tagline",
      "name": "Tagline",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Tagline",
          "default": "Tagline"
        }
      ]
    },
    {
      "type": "text",
      "name": "Tekst",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Tekst",
          "default": "<p>Skriv din tekst her.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Knap",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Knaptekst",
          "default": "Læs mere"
        },
        {
          "type": "select",
          "id": "link_type",
          "label": "Linker til",
          "default": "custom",
          "options": [
            {
              "value": "custom",
              "label": "Linket herunder"
            },
            {
              "value": "route",
              "label": "Rutevejledning (fra tema-indstillinger)"
            },
            {
              "value": "phone",
              "label": "Ring op (fra tema-indstillinger)"
            }
          ]
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Udseende",
          "default": "primary",
          "options": [
            {
              "value": "primary",
              "label": "Udfyldt"
            },
            {
              "value": "secondary",
              "label": "Kant"
            },
            {
              "value": "buy",
              "label": "Køb (ristet rød)"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Costa: hero",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "tagline"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
