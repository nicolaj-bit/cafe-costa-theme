{%- liquid
  assign color_class = ''
  if section.settings.color == 'surface'
    assign color_class = ' costa--surface'
  elsif section.settings.color == 'dark'
    assign color_class = ' costa--dark'
  endif
-%}

{%- assign has_media = false -%}
{%- if section.settings.image != blank and section.settings.image_position != 'none' -%}{%- assign has_media = true -%}{%- endif -%}
<section
  class="costa{{ color_class }}{% if section.settings.center %} costa--center{% endif %}"
  {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}"{% endif %}
>
  <div class="costa__inner{% unless has_media %} costa__inner--narrow{% endunless %}">
    <div class="costa-split{% if has_media %} costa-split--has-media costa-split--media-{{ section.settings.image_position }}{% endif %}">
      {%- if has_media -%}
        <div class="costa-split__media" style="--costa-media-ratio: {{ section.settings.ratio }};">
          {%- render 'costa-image', image: section.settings.image, sizes: '(min-width: 750px) 50vw, 100vw' -%}
        </div>
      {%- endif -%}
      <div class="costa-split__text">
        {%- render 'costa-block-content', blocks: section.blocks -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Costa: tekst med billede",
  "tag": "div",
  "class": "costa-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Billede"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Billedets placering",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Venstre"
        },
        {
          "value": "right",
          "label": "Højre"
        },
        {
          "value": "none",
          "label": "Intet billede"
        }
      ]
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Billedformat",
      "default": "4 / 3",
      "options": [
        {
          "value": "4 / 3",
          "label": "Liggende"
        },
        {
          "value": "1 / 1",
          "label": "Kvadrat"
        },
        {
          "value": "3 / 4",
          "label": "Stående"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "center",
      "label": "Centrér teksten",
      "default": false
    },
    {
      "type": "select",
      "id": "color",
      "label": "Baggrund",
      "default": "bg",
      "options": [
        {
          "value": "bg",
          "label": "Lys"
        },
        {
          "value": "surface",
          "label": "Flade"
        },
        {
          "value": "dark",
          "label": "Mørk"
        }
      ]
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anker-id (til links som #morgenmad)",
      "info": "Kun små bogstaver og bindestreger."
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Overskrift",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Overskrift",
          "default": "Overskrift"
        },
        {
          "type": "select",
          "id": "tag",
          "label": "Niveau",
          "default": "h2",
          "options": [
            {
              "value": "h1",
              "label": "H1 – sidens hovedoverskrift"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            },
            {
              "value": "p",
              "label": "Almindelig tekst"
            }
          ]
        }
      ]
    },
    {
      "type": "subheading",
      "name": "Underoverskrift",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Tekst",
          "default": "Underoverskrift"
        }
      ]
    },
    {
      "type": "text",
      "name": "Tekst",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Tekst",
          "default": "<p>Skriv din tekst her.</p>"
        }
      ]
    },
    {
      "type": "quote",
      "name": "Citat",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Citat",
          "default": "<p>Citat</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Afsender"
        }
      ]
    },
    {
      "type": "button",
      "name": "Knap",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Knaptekst",
          "default": "Læs mere"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Udseende",
          "default": "primary",
          "options": [
            {
              "value": "primary",
              "label": "Udfyldt"
            },
            {
              "value": "secondary",
              "label": "Kant"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Costa: tekst med billede",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
