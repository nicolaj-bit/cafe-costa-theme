{%- liquid
  assign color_class = ''
  if section.settings.color == 'surface'
    assign color_class = ' costa--surface'
  elsif section.settings.color == 'dark'
    assign color_class = ' costa--dark'
  elsif section.settings.color == 'harbor'
    assign color_class = ' costa--harbor'
  endif
-%}

{%- capture promises -%}
  {%- for block in section.blocks -%}
    <li class="costa-promise" {{ block.shopify_attributes }}>
      {%- if block.settings.label != blank -%}<p class="costa-label">{{ block.settings.label | escape }}</p>{%- endif -%}
      <p class="costa-promise__title">{{ block.settings.title }}</p>
      {%- if block.settings.text != blank -%}<p class="costa-promise__text">{{ block.settings.text }}</p>{%- endif -%}
    </li>
  {%- endfor -%}
{%- endcapture -%}
<section class="costa costa-promises{{ color_class }}">
  {%- if section.settings.autoplay -%}
    <div class="costa-marquee" style="--costa-marquee-duration: {{ section.settings.speed }}s;">
      <ul class="costa-marquee__track costa-promises__track">
        {{ promises }}
        {%- comment -%} Kopi, så båndet kan rulle i ring. Skjult for skærmlæsere. {%- endcomment -%}
        {{ promises | replace: '<li class="costa-promise"', '<li aria-hidden="true" class="costa-promise"' }}
      </ul>
    </div>
  {%- else -%}
    <div class="costa__inner">
      <ul class="costa-promises__list" data-costa-slide>{{ promises }}</ul>
    </div>
    <script>
      // Mobil: glid til næste løfte hvert 4. sekund. Står stille, når kunden selv
      // rører båndet, når siden er skjult, og for brugere, der har slået bevægelse fra.
      (() => {
        for (const liste of document.querySelectorAll('[data-costa-slide]')) {
          if (liste.dataset.klar) continue;
          liste.dataset.klar = '1';
          const mobil = window.matchMedia('(max-width: 749px)');
          const rolig = window.matchMedia('(prefers-reduced-motion: reduce)');
          let pause = false;
          let timer;
          const hold = () => { pause = true; clearTimeout(timer); timer = setTimeout(() => { pause = false; }, 8000); };
          for (const e of ['pointerdown', 'touchstart', 'focusin', 'wheel']) liste.addEventListener(e, hold, { passive: true });
          setInterval(() => {
            if (!mobil.matches || rolig.matches || pause || document.hidden || liste.children.length < 2) return;
            const trin = liste.children[1].offsetLeft - liste.children[0].offsetLeft;
            const sidst = liste.scrollLeft + liste.clientWidth >= liste.scrollWidth - 4;
            liste.scrollTo({ left: sidst ? 0 : liste.scrollLeft + trin });
          }, 4000);
        }
      })();
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Costa: løfter",
  "tag": "div",
  "class": "costa-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Rul automatisk som et bånd",
      "default": false,
      "info": "Stopper, når musen holdes over. Står stille for brugere, der har slået bevægelse fra."
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Tid for én omgang",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "s",
      "default": 36
    },
    {
      "type": "select",
      "id": "color",
      "label": "Baggrund",
      "default": "bg",
      "options": [
        {
          "value": "bg",
          "label": "Papir"
        },
        {
          "value": "surface",
          "label": "Kort (lysere papir)"
        },
        {
          "value": "dark",
          "label": "Mørk"
        },
        {
          "value": "harbor",
          "label": "Havneblå"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "promise",
      "name": "Løfte",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Etiket",
          "default": "01"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Løfte",
          "default": "Kort løfte"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Uddybning (valgfri)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Costa: løfter",
      "blocks": [
        {
          "type": "promise"
        },
        {
          "type": "promise"
        },
        {
          "type": "promise"
        },
        {
          "type": "promise"
        }
      ]
    }
  ]
}
{% endschema %}
