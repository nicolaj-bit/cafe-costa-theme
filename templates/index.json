        "card_15": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/costa-fokus-risteriet.jpg",
            "title": "Risteriet",
            "text": "<p>Vores kafferisteri, placeret i hjertet af caféen, fungerer som et åbent værksted, hvor gæsterne inviteres indenfor i processen.</p>",
            "link": "shopify://pages/risteriet",
            "button_label": "Læs mere"
          }
        },
        "card_16": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/costa-fokus-kaffevogn.jpg",
            "title": "Kaffevogn",
            "text": "<p>Vi bringer den fulde caféoplevelse og byens bedste kaffe til næsten enhver lokation. Med vognen følger højkvalitetskaffe og professionelt udstyr.</p>",
            "link": "shopify://pages/kaffevogn",
            "button_label": "Læs mere"
          }
        },
        "card_17": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/costa-fokus-erhverv.jpg",
            "title": "Kaffe til erhverv",
            "text": "<p>Sammen med en partner kan vi levere, installere og træne i alle typer maskiner. Kaffeautomater, espresso maskine, kværn, osv.</p>",
            "link": "shopify://pages/kaffe-til-erhverv",
            "button_label": "Læs mere"
          }
        }
      },
