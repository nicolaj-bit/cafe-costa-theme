      "blocks": {
        "heading_217": {
          "type": "heading",
          "settings": {
            "heading": "Hvorfor “Costa Kalundborg Kaffe”?",
            "tag": "h2"
          }
        },
        "text_218": {
          "type": "text",
          "settings": {
            "text": "<p>En strandelskende New Zealænder flytter til Kalundborg ved fjorden, tager på ferie til Costa del Sol med nogle danske venner, der er vokset op med Shu-bi-dua. – Behøves der, at siges mere? Desuden ligger navnet godt i munden, lige som god friskbrygget kaffe.</p>"
          }
        }
      },
      "block_order": [
        "heading_217",
        "text_218"
      ]
